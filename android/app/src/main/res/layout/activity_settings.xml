<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- =========================================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_touch_header"
            android:textAppearance="@style/A51.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swTouch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_touch_enabled"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_touch_enabled_sum"
                android:textAppearance="@style/A51.Subtitle"
                android:textSize="11sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swLook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_look_enabled"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swInvertY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_invert_y"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_deadzone"
                android:textAppearance="@style/A51.Subtitle" />

            <SeekBar
                android:id="@+id/sbDeadzone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_look_sensitivity"
                android:textAppearance="@style/A51.Subtitle" />

            <SeekBar
                android:id="@+id/sbSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="100" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditLayout"
                style="@style/A51.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_touch_edit" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_touch_edit_sum"
                android:textAppearance="@style/A51.Subtitle"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- =========================================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_perf_header"
            android:textAppearance="@style/A51.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_target_fps"
                android:textAppearance="@style/A51.Subtitle" />

            <RadioGroup
                android:id="@+id/rgFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFps30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="30"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbFps60"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="60"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbFps90"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="90"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbFps120"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="120"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAutoQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_auto_quality"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_auto_quality_sum"
                android:textAppearance="@style/A51.Subtitle"
                android:textSize="11sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swThermal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_thermal"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_thermal_sum"
                android:textAppearance="@style/A51.Subtitle"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_quality_ceiling"
                android:textAppearance="@style/A51.Subtitle" />

            <SeekBar
                android:id="@+id/sbQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3"
                android:progress="3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_fixed_scale"
                android:textAppearance="@style/A51.Subtitle" />

            <SeekBar
                android:id="@+id/sbScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_fixed_scale_sum"
                android:textAppearance="@style/A51.Subtitle"
                android:textSize="11sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_show_hud"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- =========================================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_device_header"
            android:textAppearance="@style/A51.Section" />

        <TextView
            android:id="@+id/tvDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:padding="12dp"
            android:textAppearance="@style/A51.Subtitle"
            android:textSize="12sp"
            tools:text="Tier: High\nRAM: 6 GB\nCPU: 8 cores @ 2.4 GHz" />

    </LinearLayout>
</ScrollView>
